{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/sse/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/message/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
