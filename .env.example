# ── Authentication ────────────────────────────────────────────────────────────
# Optional bearer token required on /api/sse and /api/message.
# If unset the endpoints are open — set this before exposing publicly.
MCP_AUTH_TOKEN=

# ── Browser ───────────────────────────────────────────────────────────────────
# Connect to an existing Chrome/Chromium over CDP (websocket or http endpoint,
# e.g. Browserless / Steel / your own chrome --remote-debugging-port=9222).
# Takes precedence over every other browser launch path.
CDP_ENDPOINT=
# Path to a local Chrome/Chromium binary for local development
# (only used when CDP_ENDPOINT is unset and not running on Vercel).
PUPPETEER_EXECUTABLE_PATH=

# ── Proxying ──────────────────────────────────────────────────────────────────
# Default upstream proxy used by fetch_url and take_screenshot when the caller
# does not pass an explicit `proxy` argument.
# Supported schemes: http://  https://  socks5://  socks5h://  socks4://
# Credentials may be embedded: socks5://user:pass@host:1080
SCRAPER_PROXY_URL=
# Standard proxy env vars are honoured as a fallback for fetch_url.
HTTP_PROXY=
HTTPS_PROXY=

# ── Movie metadata providers ──────────────────────────────────────────────────
# TMDB v3 API key (https://developer.themoviedb.org) — primary provider.
TMDB_API_KEY=
# OMDb API key (https://www.omdbapi.com/apikey.aspx) — secondary provider.
OMDB_API_KEY=
# With no keys configured, movie_metadata falls back to public Wikipedia data.

# ── Limits ────────────────────────────────────────────────────────────────────
# Per-IP rate limit for tool invocations (fixed window). 0 disables.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# Hard cap on fetched response bodies (bytes). Default 5 MiB.
FETCH_MAX_BYTES=5242880
# Default per-request timeout for fetch_url (ms).
FETCH_DEFAULT_TIMEOUT_MS=20000
